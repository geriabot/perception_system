# Follow one person and keep a TF frame on them, recognizing them again by their appearance when
# the tracker loses them (they leave the image, someone crosses in front): another person of the
# class is never taken for them. It runs until it is cancelled or the person is lost for longer
# than lost_timeout_s. Served by /perception_orchestrator (the behavior follow_person).

# The class of the person (empty: person) and its base category, also searched
string class_name
string category
# Which one to follow at the start: nearest (to the camera) or first (the first confirmed)
string selection
# The TF frame to publish. Empty: followed_person
string frame_id
# How long to search at the start. 0: no limit
float32 find_timeout_s
# How long they may be out of view (not recognized again) before the goal ends. 0: 10 s
float32 lost_timeout_s
# The detection model (empty: the default of the system): omdet, grounding_dino, yolo,
# yolo_world, sam3, color_blobs (docs/MODELS.md); its options, YAML (e.g. "{threshold: 0.35}")
string model
string model_options
# The tracker (empty: the default): strongsort, bytetrack, botsort, ocsort, deepocsort
string tracker
---
# Why it ended: cancelled, not found, lost
string reason
# The tracker id of the person when it ended (it changes when they are recognized again)
string id
---
# SEARCHING, FOLLOWING or LOST
string state
string id
# Times the person was recognized again with another tracker id
int32 reidentifications
# The person, as the detection request sees them in the last image
TrackedObject object
